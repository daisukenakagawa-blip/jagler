{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 既存の Worker（AgentMint など）とは別名・別リソース。既存設定には一切触れない
  "name": "meme-radar-ai",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // database_id を書かない = 初回デプロイ時に wrangler が D1 を自動作成して紐付ける
  "d1_databases": [
    { "binding": "DB", "database_name": "meme-radar-db", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // D1 無料枠は 1 日 10 万行書き込み。余裕を残して 8 万で自動停止
    "DAILY_WRITE_BUDGET": "80000",
    "MAX_NEW_TOKENS_PER_RUN": "2",
    "RETENTION_DAYS": "90"
  },
  "observability": { "enabled": true }
}
